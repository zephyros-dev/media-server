{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions of the router deploy, in its own file so that a bump doesn't run the server deployment (same as the dependencies.yaml of github>zephyros-dev/renovate-config)",
      "managerFilePatterns": ["/^deploy/tasks/openwrt/dependencies\\.yaml$/"],
      "matchStrings": ["(?<depName>.+?): (?<currentValue>.*?)\n"],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Pinned container images in deploy/cue/images.cue (`\"name\": \"repo:tag@sha256:...\"`)",
      "managerFilePatterns": ["/^deploy/cue/images\\.cue$/"],
      "matchStrings": [
        "\": \"(?<depName>[^\"@]+):(?<currentValue>[^\"@:]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "\": \"{{{depName}}}:{{{newValue}}}@{{{newDigest}}}\""
    }
  ],
  "extends": [
    "github>zephyros-dev/docker-koreader",
    "github>zephyros-dev/renovate-config"
  ],
  "git-submodules": {
    "enabled": true
  },
  "ignoreTests": true,
  "packageRules": [
    {
      "description": "Local tools (mise.dev.toml) don't affect the deployment, so no need for daily updates",
      "matchFileNames": ["mise.dev.toml"],
      "schedule": ["* 1-14 * * 1"]
    },
    {
      "automerge": false,
      "matchPackageNames": ["/python/", "/cue/"],
      "matchUpdateTypes": ["major", "minor"]
    },
    {
      "automerge": false,
      "groupName": "immich",
      "matchPackageNames": ["/ghcr.io/immich-app/"],
      "matchUpdateTypes": ["major", "minor"]
    },
    {
      "groupName": "caddy",
      "matchPackageNames": ["/caddy/"]
    },
    {
      "automerge": false,
      "groupName": "caddy",
      "matchPackageNames": ["/caddy/"],
      "matchUpdateTypes": ["major", "minor"]
    }
  ],
  "schedule": ["* 1-14 * * *"],
  "updateNotScheduled": false
}
